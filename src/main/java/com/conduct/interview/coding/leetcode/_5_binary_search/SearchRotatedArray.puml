@startuml
skinparam ActivityFontSize 13
skinparam ActivityDiamondFontSize 12

start

:Set lo = 0, hi = nums.length - 1;

while (lo <= hi?) is (yes)
    :Calculate mid = lo + (hi - lo) / 2;

    if (nums[mid] == target?) then (yes)
        :Return mid (Index found);
        stop
    endif

    if (nums[lo] <= nums[mid]?) then (Left side is sorted)
        if (nums[lo] <= target AND target < nums[mid]?) then (yes)
            :hi = mid - 1\n(Search in Left);
        else (no)
            :lo = mid + 1\n(Search in Right);
        endif
    else (Right side is sorted)
        if (nums[mid] < target AND target <= nums[hi]?) then (yes)
            :lo = mid + 1\n(Search in Right);
        else (no)
            :hi = mid - 1\n(Search in Left);
        endif
    endif
endwhile (no)

:Return -1 (Not found);
stop

@enduml