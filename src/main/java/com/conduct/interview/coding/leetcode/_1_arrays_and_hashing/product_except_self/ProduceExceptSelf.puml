@startuml
skinparam ActivityFontSize 13
skinparam ActivityDiamondFontSize 12

start

:Input array nums, n = nums.length;
:Create result array of size n;
:Set result[0] = 1;

partition "Pass 1: Left Products (Prefixes)" {
    :i = 1;
    while (i < n?) is (yes)
        :result[i] = result[i - 1] * nums[i - 1];
        :i = i + 1;
    endwhile (no)
}

partition "Pass 2: Right Products (Suffixes) & Merge" {
    :Set suffix = 1;
    :i = n - 1;
    while (i >= 0?) is (yes)
        :result[i] = result[i] * suffix;
        :suffix = suffix * nums[i];
        :i = i - 1;
    endwhile (no)
}

:Return result;
stop

@enduml